# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Test / coverage
.coverage
.coverage.*
htmlcov/
website/coverage/
.pytest_cache/
.ruff_cache/

# Env
.venv/
venv/

# Claude Code — track the committed adapters under .claude/commands/, ignore harness-local state
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json
.keel/state/

# Editors — Obsidian vault config (local markdown app, not part of the repo)
.obsidian/
jury.toml

# Agent scratch plans — working notes, not repo content. Tracking one means every
# agent run that rewrites its plan lands as a source change in an unrelated PR.
/plan.md
# Root-level scratch scripts, same reason: real tests live in tests/, so a
# test_*.py at the repo root is a throwaway an agent left behind (#616).
/test_*.py
